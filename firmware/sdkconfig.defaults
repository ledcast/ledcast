CONFIG_IDF_TARGET="esp32s3"

# Внешняя SPI Flash cFeon QH64A держит максимум ~50 МГц и ломает запись в QIO.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Лог идёт в UART-пады — к ним подключается программатор на монтаже, и это
# единственный способ увидеть загрузку, когда плата уже стоит в конструкции.
# Нативный USB остаётся вторичной консолью, так что лог виден и там.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Откат прошивки на уровне загрузчика: новая сборка подтверждается только
# после того, как health-компонент убедился, что она живая.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Через app_main проходят структуры конфигурации в килобайт с лишним, а стек
# главной задачи выделяется из кучи: его переполнение затирает не свою память
# и всплывает потом падением аллокатора в совсем другом месте.
#
# Замер на приборе: пик потребления 6184 байта, из них больше половины —
# копии DeviceConfig в config_init. На прежних 6144 запас был отрицательным,
# и плата уходила в вечную петлю падений: сначала StoreProhibited в списке
# обработчиков событий, затем срабатывание сторожа стека в безопасном режиме.
# Две тысячи байт сверх пика держат путь запуска устойчивым к правкам.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_FREERTOS_HZ=1000

# DDP приходит пачками UDP, поэтому запас буферов нужен. Но видеопоток
# гонит шестьсот полуторакилобайтных пакетов в секунду, и глубокая очередь
# оборачивается десятками килобайт кучи в момент, когда приёмник чуть отстал.
# Переполнение очереди — это потеря пакета, то есть одна рваная строка кадра;
# исчерпанная куча роняет всё устройство, поэтому размен идёт в пользу памяти.
#
# Замер на живом приборе, минута видео 192×48 при 30 к/с:
#   32 → потерь 0,05 %, свободной памяти в минимуме 24 КБ
#   16 → потерь 0,59 %, свободной памяти в минимуме 43 КБ
#    8 → потерь 1,98 %, свободной памяти в минимуме 59 КБ
#
# Тогда выбрали 16: буфер вывода держал две копии кадра плюс промежуточное
# полотно, и памяти не было. Теперь копия одна, полотна нет, и в минимуме
# свободно под 80 КБ — размен возвращается в пользу потерь. Кадр видео приходит
# пачкой из четырёх с лишним десятков пакетов подряд, и на этом всплеске очередь
# переполняется быстрее, чем задача успевает её разобрать.
# Тогда выбрали 32, потому что памяти хватало. Не хватает: замер на живом
# приборе показал, что старт потока роняет свободную кучу примерно на 60 КБ
# разом. Очередь глубиной 32 держит до тридцати двух датаграмм, и каждая
# приколачивает свой буфер приёма Wi-Fi (около 1,6 КБ) — это и есть пятьдесят
# с лишним килобайт при шестидесяти четырёх свободных всего. Шестнадцать
# ограничивают всплеск примерно двадцатью шестью килобайтами, оставляя место
# вебу и приёму. Потери по прежнему замеру растут с 0,05 % до 0,59 % — одна
# рваная строка на две сотни кадров против потери управления прибором.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Сокеты делит веб (max_open_sockets=4 у httpd, components/webui/webui_server.cpp)
# с DDP (1) — итого пять. mDNS в счёт не входит: он поднят без
# CONFIG_MDNS_NETWORKING_SOCKET и ходит через внутренний netconn стека, а не
# через lwip_socket. Запас 12 - 6 = 6 берёт временные пересоздания соединений
# при перезаходе клиента в веб.
CONFIG_LWIP_MAX_SOCKETS=12

# Очередь отправки и окно приёма на КАЖДОЕ соединение TCP. lwip в ESP-IDF берёт
# их из общей кучи, а не из статического пула: дефолт 5760 при шестнадцати
# допустимых соединениях — это до 92 КБ на одну лишь отправку при 64 КБ
# свободных. Отсюда и падение до килобайта под тридцатью клиентами.
# Самый крупный ответ прибора — страница интерфейса, статус занимает 1,9 КБ:
# в два сегмента MSS (2880) он укладывается целиком, и на локальной сети окно
# в 2880 байт даёт около полумегабайта в секунду — выше, чем пишет flash при
# заливке прошивки. Потолок расхода падает вдвое, скорость не упирается.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880

# Сколько соединений TCP вообще может существовать разом. Всё сверх этого числа
# получает отказ на уровне протокола, не потратив ни байта кучи, — а это и есть
# требование «отказать быстро, а не принять и умереть».
#
# Это число — множитель к обоим буферам выше: потолок расхода на TCP равен
# MAX_ACTIVE_TCP * (SND_BUF + WND). Веб обслуживает запросы по одному, задача
# httpd в системе одна, поэтому лишние соединения не давали пропускной
# способности — только расход. Шесть покрывают пять сокетов сервера и
# закрывающиеся соединения поверх них; потолок TCP при этом около 34 КБ.
CONFIG_LWIP_MAX_ACTIVE_TCP=6

# Сколько закрытое соединение занимает место в TIME_WAIT (два таких срока).
# Минута — величина для интернета с его переупорядочиванием пакетов; здесь
# площадочная сеть, и минута означала, что три десятка коротких запросов
# держат пул pcb занятым, пока живые клиенты получают отказ.
CONFIG_LWIP_TCP_MSL=10000


# Задача сетевого стека (tiT) идёт с приоритетом 18 — выше всего, что заводит
# прошивка. По умолчанию она не привязана к ядру и потому может встать на ядро 1
# и вытеснить рендер (приоритет 5): это единственная задача в системе, способная
# это сделать. Ядро 1 отдано выводу на матрицу, сеть живёт на ядре 0.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Входная очередь задачи сетевого стека. Каждый стоящий в ней пакет держит за
# собой буфер приёма Wi-Fi, поэтому глубина очереди — это ещё один множитель к
# тем же полутора килобайтам. Шестнадцать хватает: очередь разбирает задача с
# приоритетом 18, выше всего в системе, и глубже неё она не набирается иначе
# как при полной остановке стека.
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# Дефолт ESP-IDF — 32/32, буфер держит доступную память под пиковую нагрузку,
# а не под типичную. Приём тут тяжелее отдачи: DDP гонит видео внутрь платы,
# а наружу уходят только HTTP-ответы и раз в пять кадров в секунду статус и
# предпросмотр по WebSocket. Половина от дефолта на приём — тот же шаг, что уже
# подтверждён на RECVMBOX_SIZE (32 → 16), и с запасом выше рекомендованных
# ESP_WIFI_RX_BA_WIN = 6. Точную цифру выигрыша под живой видеопоток проверяет
# только замер на приборе — так же, как и для RECVMBOX_SIZE.
# Половина от дефолта всё ещё означала до тридцати двух буферов по полтора
# килобайта, выданных из кучи разом, — то есть потолок расхода около 50 КБ при
# 64 свободных. Наплыв в тридцать клиентов набирает его за доли секунды, и
# именно это, а не веб-сервер, оставляло от кучи килобайт. Шестнадцать держат
# потолок около 26 КБ и остаются втрое выше рекомендованного ESP_WIFI_RX_BA_WIN
# = 6; статические шестнадцать буферов при этом никуда не делись и принимают
# первыми. Двенадцать держат потолок около 19 КБ — вместе с потолком TCP это
# укладывается в свободную кучу с запасом выше приёмочных 16 КБ.
#
# Стояло 32, и это измерено: старт потока на строке из пяти модулей
# опускал свободную кучу до 1,8 КБ (на 0.1.0 — до 16 байт). Кадры видео теперь
# лежат в памяти, сколько её есть, поэтому всплеск Wi‑Fi обязан помещаться в
# запас приёмника (24 + 16 КБ): шестнадцать буферов — около 26 КБ.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Статические буферы приёма драйвер раздаёт до того, как пакет доберётся до
# сокета: их нехватка отбрасывает пакет в самом низу, и на приёме это видно как
# потери, которых не объяснить эфиром. Дефолт ESP-IDF — 10, для плотного UDP мало.
# Стояло 24 — это 38 КБ навсегда. Кадр видео приходит пачками по 3–13 пакетов
# с разносом по периоду, сокет держит 12 КиБ: шестнадцати хватает, а 13 КБ
# уходят на кадр строки из десяти модулей.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_WS_SUPPORT=y

# Библиотека вывода по умолчанию тянет Adafruit GFX, а тот — весь Arduino.
# Рисуем мы своим кодом через display_set_pixel, графический слой не нужен.
CONFIG_ESP32_HUB75_USE_GFX=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Keep the provisioning radio awake even without a saved AP in range.
# CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE is not set
