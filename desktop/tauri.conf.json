{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEDCAST Console",
  "version": "0.1.0",
  "identifier": "com.ledcast.console",
  "build": {
    "frontendDist": "web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LEDCAST Console",
        "width": 896,
        "height": 780,
        "minWidth": 630,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
